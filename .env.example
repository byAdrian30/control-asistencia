# ==============================================================
# CONFIGURACIÓN DE SUPABASE
# Obtén estos valores en supabase.com -> Project Settings -> API
# ==============================================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta-para-crons

# ==============================================================
# CONFIGURACIÓN DE TELEGRAM (Alertas de tardanzas al mediodía)
# ==============================================================
# Token creado en @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Tu ID personal o ID del grupo de supervisores (ej: -100123456789)
TELEGRAM_CHAT_ID=123456789
STORE_NAME=Tienda Principal

# ==============================================================
# SEGURIDAD DE CRON JOBS (Opcional para proteger endpoints)
# ==============================================================
CRON_SECRET=tu_secreto_aleatorio_aqui
